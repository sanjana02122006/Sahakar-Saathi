# ---------------------------------------------------------------
# Copy to .env.local, or run: SB_TOKEN=sbp_xxx npm run env:pull
# ---------------------------------------------------------------

# Supabase (public — safe to ship to the browser, protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=https://qstqjrlcdihyawszaqis.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. NEVER prefix with NEXT_PUBLIC_.
# Used by Edge Functions; Supabase injects it automatically at runtime.
SUPABASE_SERVICE_ROLE_KEY=

# --- REQUIRED: you must supply these ---
# Google AI Studio -> https://aistudio.google.com/apikey  (free tier available)
# Powers both embeddings (text-embedding-004) and chat (gemini-2.0-flash).
GEMINI_API_KEY=

# --- OPTIONAL: better Indic voice quality than the browser's built-in ---
# Sarvam AI -> https://dashboard.sarvam.ai  (STT/TTS tuned for Indian languages)
SARVAM_API_KEY=

# --- ESP32 hardware terminal auth ---
# Server-side only, used by trigger-mic / voice-fetch / voice-upload to
# authenticate the physical device (it can't produce a Supabase user JWT,
# so it posts this shared key instead — see each function's index.ts).
# Generate any long random string yourself; it must match the value
# flashed into esp32-firmware/voice_terminal.ino.
DEVICE_API_KEY=

# --- Document integrity anchoring (see BLOCKCHAIN-PLAN.md) ---
# Server-side only, used ONLY by the anchor-document Edge Function.
# NEVER prefix with NEXT_PUBLIC_. Generate a wallet DEDICATED to this
# purpose (never reuse a personal/other-project wallet), fund it with
# free Amoy testnet MATIC from https://faucet.polygon.technology/
# (select Amoy), then: supabase secrets set POLYGON_SIGNER_PRIVATE_KEY=...
# verify-document never reads this secret -- it only does read-only
# chain lookups, which need no key.
POLYGON_SIGNER_PRIVATE_KEY=
# Optional override; defaults to https://rpc-amoy.polygon.technology in
# both anchor-document and verify-document if unset.
POLYGON_RPC_URL=
